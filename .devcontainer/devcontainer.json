{
  "name": "EnterpriseDoc AI - Codespace",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "enableNonRootDocker": "true"
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y libgl1 libglib2.0-0 tesseract-ocr && cd backend && pip install --upgrade pip && pip install -r requirements.txt && cd ../frontend && npm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss"
      ]
    }
  },
  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": {
      "label": "EnterpriseDoc AI Backend API",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "EnterpriseDoc AI Frontend Web",
      "onAutoForward": "openBrowser"
    }
  }
}
